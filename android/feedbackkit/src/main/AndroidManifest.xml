<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <queries>
        <!-- "Take Photo" in the composer's attach menu only appears when a camera app exists. -->
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
    </queries>

    <application>
        <activity
            android:name="com.feedbackkit.ui.FeedbackActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode"
            android:theme="@style/FeedbackKit.Theme"
            android:windowSoftInputMode="adjustResize|stateHidden" />

        <!-- Tracks the foreground activity so present()/triggers need no Activity
             argument (what the Flutter and React Native bridges rely on). -->
        <provider
            android:name="com.feedbackkit.internal.FeedbackKitInitializer"
            android:authorities="${applicationId}.feedbackkit-init"
            android:exported="false" />

        <!-- Where "Take Photo" asks the camera app to write its full-size image. -->
        <provider
            android:name="com.feedbackkit.internal.FeedbackKitFileProvider"
            android:authorities="${applicationId}.feedbackkit-files"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
