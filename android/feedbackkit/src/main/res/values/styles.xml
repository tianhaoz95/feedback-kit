<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Framework themes only (no AppCompat), so the SDK carries no androidx dependency. -->
    <style name="FeedbackKit.Theme" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="FeedbackKit.Dialog" parent="android:Theme.Material.Light.Dialog.Alert" />
</resources>
