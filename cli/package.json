{
  "name": "feedbackkit-cli",
  "version": "0.1.0",
  "description": "CLI + MCP server for reading FeedbackKit dashboard feedback from a coding agent.",
  "type": "module",
  "bin": {
    "feedbackkit": "dist/index.js",
    "feedbackkit-cli": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b && chmod +x dist/index.js",
    "prepublishOnly": "npm run build",
    "dev": "tsc -b --watch",
    "lint": "tsc -b --noEmit",
    "test": "npm run build && node --test test/*.test.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tianhaoz95/feedback-kit.git",
    "directory": "cli"
  },
  "homepage": "https://github.com/tianhaoz95/feedback-kit#readme",
  "bugs": {
    "url": "https://github.com/tianhaoz95/feedback-kit/issues"
  },
  "keywords": [
    "feedback",
    "ios",
    "mcp",
    "mcp-server",
    "coding-agent",
    "feedbackkit"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@supabase/supabase-js": "^2.116.0",
    "commander": "^15.0.0",
    "open": "^11.0.4",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=18"
  }
}
