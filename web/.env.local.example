# Copy to .env.local. Values below are the fixed defaults `supabase start`
# uses for local development (see ../scripts/start-web.sh). For a cloud
# Supabase project, use its project URL and anon/publishable key instead.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=replace-with-anon-key-from-supabase-status

# Optional: send the dashboard's own "Feedback" reports (the dogfooded web SDK)
# to a project in this stack. Unset in dev = the Feedback button is hidden.
# Production builds default to the FeedbackKit team's hosted project.
# VITE_FEEDBACKKIT_PROJECT_KEY=pk_...
