name: FeedbackKit agent

# Runs Claude Code on a self-hosted Mac whenever FeedbackKit hands it a
# report: FeedbackKit creates a GitHub issue and adds the `__DISPATCH_LABEL__`
# label (project Settings → Coding agent loop). Because the job runs on your
# own Mac, the agent can build the app, run it in the Simulator and attach a
# screenshot or short video of the fix, shown in the report's After view.
# Its PR carries `FeedbackKit: <id>`, so the report
# moves to "PR open" → "merged" → shipped → verified by the reporter.
#
# Adapt: __DISPATCH_LABEL__, the allowed tools for your build (xcodebuild,
# npm, …). Secrets: CLAUDE_CODE_OAUTH_TOKEN (`claude setup-token`) or
# ANTHROPIC_API_KEY, and FEEDBACKKIT_AGENT_TOKEN (an "Agent runner" access
# token) for the FeedbackKit MCP tools. The Claude GitHub App must be
# installed on the repo.

on:
  issues:
    types: [labeled]
  issue_comment:
    types: [created]

permissions:
  contents: write
  issues: write
  pull-requests: write
  id-token: write

# One run per issue; a re-dispatch (reporter reopened) replaces a stale one.
concurrency:
  group: feedbackkit-agent-${{ github.event.issue.number }}
  cancel-in-progress: true

jobs:
  agent:
    # Label from FeedbackKit (or a person), or an @claude comment from someone with write access.
    if: >-
      (github.event_name == 'issues' && github.event.label.name == '__DISPATCH_LABEL__') ||
      (github.event_name == 'issue_comment' && contains(github.event.comment.body, '@claude'))
    runs-on: [self-hosted, macOS, feedbackkit-agent]
    timeout-minutes: 60
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: Issue a FeedbackKit token for this report
        # The agent-runner token (FEEDBACKKIT_AGENT_TOKEN: an access token with
        # tokens:issue, from project Settings → Access tokens) never reaches the
        # agent. It issues a token limited to this one report that expires in
        # 90 minutes, and only that goes to the FeedbackKit MCP server. Skipped
        # (the MCP server falls back to the runner's `feedbackkit login`, if
        # any) when the secret isn't set.
        env:
          FEEDBACKKIT_TOKEN: ${{ secrets.FEEDBACKKIT_AGENT_TOKEN }}
          ISSUE_BODY: ${{ github.event.issue.body }}
        run: |
          FEEDBACK_ID="$(printf '%s' "$ISSUE_BODY" | grep -oE 'FeedbackKit: [0-9a-fA-F-]{36}' | head -n1 | cut -d' ' -f2 || true)"
          if [ -n "$FEEDBACKKIT_TOKEN" ] && [ -n "$FEEDBACK_ID" ]; then
            RUN_TOKEN="$(npx -y feedbackkit-cli@latest token issue --feedback "$FEEDBACK_ID" --ttl 90 --name "run ${GITHUB_RUN_ID}")"
            echo "::add-mask::$RUN_TOKEN"
            echo "FEEDBACKKIT_RUN_TOKEN=$RUN_TOKEN" >> "$GITHUB_ENV"
          fi

      - uses: anthropics/claude-code-action@v1
        with:
          claude_code_oauth_token: ${{ secrets.CLAUDE_CODE_OAUTH_TOKEN }}
          # anthropic_api_key: ${{ secrets.ANTHROPIC_API_KEY }}
          label_trigger: __DISPATCH_LABEL__
          # FeedbackKit's GitHub App adds the label; the action rejects bot
          # actors unless they're listed here.
          allowed_bots: feedbackkit-app
          # The FeedbackKit MCP server acts as this run's report-limited token
          # (or the runner user's `feedbackkit login` without one), so the agent
          # can claim the report, ask the reporter, and attach a preview of the
          # fix (`xcrun simctl io booted screenshot` / `recordVideo`).
          claude_args: >-
            --mcp-config '{"mcpServers":{"feedbackkit":{"command":"npx","args":["-y","feedbackkit-cli@latest","mcp"],"env":{"FEEDBACKKIT_TOKEN":"${{ env.FEEDBACKKIT_RUN_TOKEN }}"}}}}'
            --allowedTools "mcp__feedbackkit,Bash(xcodebuild:*),Bash(xcrun simctl:*),Bash(swift build:*),Bash(swift test:*),Bash(xcodegen:*)"
